# Copy this file to .env and set the path to the YeaZ weights you downloaded.
# The pipeline cannot find the weights without it, and segmentation stops with a
# FileNotFoundError naming the path it tried.
#
#   cp .env.example .env
#
# and then edit the path below, or generate it in place from the repository root:
#
#   echo "WEIGHTS_YEAST=$(pwd)/weights/weights_budding_BF_multilab_0_1" > .env

WEIGHTS_YEAST=/absolute/path/to/weights/weights_budding_BF_multilab_0_1
